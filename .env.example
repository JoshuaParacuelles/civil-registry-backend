# Backend API address for the Electron build.
# The desktop app starts the Flask backend on this address itself.
VITE_API_BASE_URL=http://127.0.0.1:5000

# Supabase public values for the frontend. Use the anon (publishable) key only.
# Never put the secret/service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=