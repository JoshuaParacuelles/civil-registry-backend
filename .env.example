# ── External SCIMS API ──────────────────────────────────────────
# Copy this file to `.env` (same folder as app.py) and fill in the
# real token. Never commit the real .env — it must stay in .gitignore.

SCIMS_API_BASE_URL=https://cictd.app/api/scims
SCIMS_API_TOKEN=paste_your_bearer_token_here
SCIMS_API_TIMEOUT=10
SCIMS_API_MAX_PAGES=50